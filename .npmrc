# Dual registry configuration for scoped package
# Default registry for public npm
registry=https://registry.npmjs.org/

# GitHub Packages registry for the @rnc scope
@rnc:registry=https://npm.pkg.github.com/

# npm Enterprise internal mirror (optional, set via environment variable)
# Set NPM_ENTERPRISE_REGISTRY in your CI/environment to use internal mirror
@rnc:registry=${NPM_ENTERPRISE_REGISTRY:-https://npm.pkg.github.com/}

# Always authenticate when publishing
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# npm Enterprise authentication (if used)
//${NPM_ENTERPRISE_HOST:-npm.example.com}/:_authToken=${NPM_ENTERPRISE_TOKEN}

# Enable strict SSL for security
strict-ssl=true

# Cache settings
cache=~/.npm

# Enterprise registry engine compatibility
engine-strict=false

# Allow pre-release versions on enterprise
tag-version-prefix="v"

# Optional: if using Verdaccio or other self-hosted registry
# @rnc:registry=https://your-company-npm.example.com/
# //your-company-npm.example.com/:_authToken=${NPM_ENTERPRISE_TOKEN}
